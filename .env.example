# Production: set these as server-side secrets in Netlify dashboard
# GOOGLE_AI_API_KEY=your_google_ai_studio_key_here
# GOOGLE_AI_MODEL=gemini-2.0-flash

# Supabase (student/teacher portals). The anon key is safe to expose in the
# client — access is enforced by Row-Level Security. Copy these from
# Supabase dashboard → Project Settings → API. Add the same VITE_* vars in Netlify.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_public_key
